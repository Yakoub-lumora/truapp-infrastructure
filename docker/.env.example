# Prometheus and Grafana Deployment Configuration
# Copy this file to .env and fill in the actual values for your deployment

# ========================================
# Docker Image Configuration
# ========================================
# Docker images to deploy to ECS
# Format: <registry>/<image>:<tag>
PROMETHEUS_IMAGE=<aws-account-id>.dkr.ecr.<aws-region>.amazonaws.com/trushot-prometheus:v2.47.0
GRAFANA_IMAGE=<aws-account-id>.dkr.ecr.<aws-region>.amazonaws.com/trushot-grafana:10.2.0

# ========================================
# Prometheus Configuration
# ========================================
# Data retention period in days
PROMETHEUS_RETENTION_DAYS=30

# Scrape interval in seconds (how often to pull metrics)
PROMETHEUS_SCRAPE_INTERVAL=15

# ========================================
# Grafana Configuration
# ========================================
# Grafana admin username
GRAFANA_ADMIN_USER=admin

# Grafana admin password (should be strong)
GRAFANA_ADMIN_PASSWORD=change-me-to-strong-password

# Allow user sign-up in Grafana (true/false)
GRAFANA_ALLOW_SIGNUP=false

# ========================================
# AWS Configuration
# ========================================
# AWS region where infrastructure is deployed
AWS_REGION=us-east-1

# AWS account ID (used for ECR image URLs)
AWS_ACCOUNT_ID=123456789012

# ========================================
# Project Configuration
# ========================================
PROJECT_NAME=trushot
ENVIRONMENT=prod

# ========================================
# Notes
# ========================================
# 1. Replace <aws-account-id> and <aws-region> in image URLs with actual values
# 2. Use strong, random passwords for GRAFANA_ADMIN_PASSWORD
# 3. Store this file securely - it contains sensitive credentials
# 4. Never commit the actual .env file to version control
# 5. Images must be pushed to ECR before deployment:
#    docker build -t <PROMETHEUS_IMAGE> ./prometheus
#    docker push <PROMETHEUS_IMAGE>
#    docker build -t <GRAFANA_IMAGE> ./grafana
#    docker push <GRAFANA_IMAGE>
