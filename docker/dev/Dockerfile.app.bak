# Development Dockerfile - optimized for fast rebuilds  
FROM node:20.10.0-alpine

# Install dependencies needed for some packages
RUN apk add --no-cache libc6-compat

# Configure npm for better network handling in Docker
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-retries 5 && \
    npm config set maxsockets 1

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install all dependencies (including dev dependencies for development)
RUN npm ci --include=dev --no-audit --no-fund || (sleep 10 && npm ci --include=dev --no-audit --no-fund) || (sleep 30 && npm install --no-audit --no-fund)

# Copy source code
COPY . .

# Expose port 3000
EXPOSE 3000

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

# Start development server with hot reload
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]